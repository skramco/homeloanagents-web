# --- Post-call recap (Netlify production / local API testing) ---

# xAI phone-number webhook signing secret (Standard Webhooks `whsec_…` from POST /v2/phone-numbers).
# Also used to verify call-ended posts from your voice session bridge (Bearer or HMAC).
XAI_WEBHOOK_SECRET=

# xAI API key for recap generation (chat/completions). Optional: falls back to generic template.
XAI_API_KEY=

# Resend (transactional email)
RESEND_API_KEY=

# Supabase (UFF Loans project) — service role only on the server
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=